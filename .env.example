# ---------- Banco de dados ----------
# Local/Docker:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Na Vercel a integração Neon cria DATABASE_URL e DATABASE_URL_UNPOOLED automaticamente.

# ---------- Segurança ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Na Vercel o cookie já é Secure por padrão. Em localhost (http) use false.
COOKIE_SECURE=false
# Protege /api/cron/monitor (a Vercel envia automaticamente "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=troque-por-outro-segredo

# ---------- Primeiro acesso (banco vazio) ----------
# Se ADMIN_EMAIL e ADMIN_PASSWORD forem definidos, cria só a empresa + gestor (produção).
# Se não forem, cria dados de DEMONSTRAÇÃO (admin@admin.com / admin).
EMPRESA_NOME=Mazzochini Materiais Laboratoriais
ADMIN_NOME=Gestor
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ---------- Alertas ----------
ALERTA_PARADO_MIN=15
ALERTA_PAUSA_MIN=30
